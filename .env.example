# Paper trading only. DO NOT put real API keys here.
# No Upbit / private exchange keys — public Bybit market data only.
# All values are safe defaults for local simulation.

NODE_ENV=development

# Symbols to watch (comma-separated)
SYMBOLS=BTCUSDT,ETHUSDT

# Assumptions for simulation
LEVERAGE=2
LONG_ONLY=true

# Fees / funding (example defaults; tune later)
TAKER_FEE_RATE=0.0006
MAKER_FEE_RATE=0.0002
# Paper futures close PnL uses this taker rate for round-trip fees (open + close notional). Falls back to TAKER_FEE_RATE.
ORBITALPHA_PAPER_FUTURES_TAKER_FEE_RATE=0.0006
# Paper proportional funding v2: hours per accrual period (open rate × holding time / interval).
ORBITALPHA_PAPER_FUTURES_FUNDING_INTERVAL_HOURS=8

# Data / logs
DATA_DIR=./data
LOG_LEVEL=info

# Loop mode (`npm run start:loop` / pm2): interval between `runOnce` calls (ms). Minimum 1000; invalid values fall back to 60000.
# On a small VPS, prefer 120000 (2m) or 300000 (5m) to reduce load; avoid very short intervals.
ORBITALPHA_PAPER_LOOP_INTERVAL_MS=60000

# --- Paper-only entry relaxation (this repo has no live trading; orbitalpha-trading is separate) ---
# Set to 1 to widen sample: looser fee/ATR gate, optional TF skip, lower quality floor.
ORBITALPHA_PAPER_ENTRY_RELAXED=0
# Override min-move multiplier (default: 1.05 if relaxed, 1.5 if strict). Lower = more entries.
# ORBITALPHA_PAPER_GATE_MOVE_MULT=1.05
# Require 5m EMA20>EMA60 when 1 (default: on if strict, off if relaxed).
# ORBITALPHA_PAPER_GATE_REQUIRE_HIGHER_TF=1
# Minimum heuristic quality score (0–100) when relaxed; ignored when not relaxed. Default 65 relaxed / 84 strict.
# ORBITALPHA_PAPER_QUALITY_MIN_SCORE=84
# Weak/sideways candidates use the lower of this and ORBITALPHA_PAPER_QUALITY_MIN_SCORE_WEAK (default 50 relaxed / 75 strict).
# ORBITALPHA_PAPER_QUALITY_MIN_SCORE_WEAK=75
# Strong trend: require (ema20-ema60)/ema60 above this for "strong" long/short (not sideways band). Default 0.004 (0.4%).
# ORBITALPHA_PAPER_STRONG_EMA_GAP_THRESHOLD=0.004
# Sideways: allow weak long/short when |emaGap| is at or below this (must be >= strong threshold). Default 0.012 (1.2%).
# ORBITALPHA_PAPER_SIDEWAYS_EMA_GAP_THRESHOLD=0.012
# Max concurrent paper positions (1–3). Default 3. File is a JSON array.
# ORBITALPHA_PAPER_MAX_OPEN_POSITIONS=3
# Min ms after last close on a symbol before opening again (reduces fee churn). Default 900000 (15m). Same-direction re-entry uses 2× this. Set 0 to disable.
# ORBITALPHA_PAPER_REENTRY_COOLDOWN_MS=900000

