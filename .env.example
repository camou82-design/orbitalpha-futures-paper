# Paper trading only. DO NOT put real API keys here.
# No Upbit / private exchange keys — public Bybit market data only.
# All values are safe defaults for local simulation.

NODE_ENV=development

# Symbols to watch (comma-separated)
SYMBOLS=BTCUSDT,ETHUSDT

# Assumptions for simulation
LEVERAGE=2
LONG_ONLY=true

# Fees / funding (example defaults; tune later)
TAKER_FEE_RATE=0.0006
MAKER_FEE_RATE=0.0002
# Paper futures close PnL uses this taker rate for round-trip fees (open + close notional). Falls back to TAKER_FEE_RATE.
ORBITALPHA_PAPER_FUTURES_TAKER_FEE_RATE=0.0006
# Paper proportional funding v2: hours per accrual period (open rate × holding time / interval).
ORBITALPHA_PAPER_FUTURES_FUNDING_INTERVAL_HOURS=8

# Data / logs
DATA_DIR=./data
LOG_LEVEL=info

# Loop mode (`npm run start:loop` / pm2): interval between `runOnce` calls (ms). Minimum 1000; invalid values fall back to 60000.
# On a small VPS, prefer 120000 (2m) or 300000 (5m) to reduce load; avoid very short intervals.
ORBITALPHA_PAPER_LOOP_INTERVAL_MS=60000

# --- Paper-only entry relaxation (this repo has no live trading) ---
# Set to 1 to widen sample: looser fee/ATR gate, optional TF skip, lower quality floor.
ORBITALPHA_PAPER_ENTRY_RELAXED=0
# Override min-move multiplier (default: 1.05 if relaxed, 1.5 if strict). Lower = more entries.
# ORBITALPHA_PAPER_GATE_MOVE_MULT=1.05
# Require 5m EMA20>EMA60 when 1 (default: on if strict, off if relaxed).
# ORBITALPHA_PAPER_GATE_REQUIRE_HIGHER_TF=1
# Minimum heuristic quality score (0–100) when relaxed; ignored when not relaxed. Default 65 relaxed / 84 strict.
# ORBITALPHA_PAPER_QUALITY_MIN_SCORE=84
# Weak/sideways candidates use the lower of this and ORBITALPHA_PAPER_QUALITY_MIN_SCORE_WEAK (default 50 relaxed / 75 strict).
# ORBITALPHA_PAPER_QUALITY_MIN_SCORE_WEAK=75
# Strong trend: require (ema20-ema60)/ema60 above this for "strong" long/short (not sideways band). Default 0.004 (0.4%).
# ORBITALPHA_PAPER_STRONG_EMA_GAP_THRESHOLD=0.004
# Sideways: allow weak long/short when |emaGap| is at or below this (must be >= strong threshold). Default 0.012 (1.2%).
# ORBITALPHA_PAPER_SIDEWAYS_EMA_GAP_THRESHOLD=0.012
# Max concurrent paper positions (1–3). Default 3. File is a JSON array.
# ORBITALPHA_PAPER_MAX_OPEN_POSITIONS=3
# Min ms after last close on a symbol before opening again (reduces fee churn). Default 900000 (15m). Same-direction re-entry uses 2× this. Set 0 to disable.
# ORBITALPHA_PAPER_REENTRY_COOLDOWN_MS=900000

# --- RANGE EXIT_RANGE_REBALANCE (box break) debounce ---
# Min ms from open before a range_box_break → EXIT_RANGE_REBALANCE may fire (default 600000 = 10m). Reduces jitter right after entry.
# ORBITALPHA_RANGE_REBALANCE_MIN_HOLD_MS=600000
# Consecutive position-close evaluations with price still outside box before exit (default 3). Set 1 to restore old single-tick behavior.
# ORBITALPHA_RANGE_REBALANCE_BOX_BREAK_CONFIRM_TICKS=3

# --- RANGE profit trail (defer EXIT_RANGE_REBALANCE until secured + pullback) ---
# Net PnL% on margin (after fees) to arm profit zone; raw box-break rebalance is deferred while armed (default 0.0012 ≈ 0.12%).
# ORBITALPHA_RANGE_PROFIT_ARM_PNL_PCT=0.0012
# Min net PnL = margin × this fraction to lock trailing (0 = breakeven net).
# ORBITALPHA_RANGE_SECURED_MIN_PNL_PCT=0
# Pullback from peak: max(span×frac, price×minFrac, ATR×mult). Defaults: 0.08 / 0.0005 / 0.35
# ORBITALPHA_RANGE_TRAIL_PULLBACK_SPAN_FRAC=0.08
# ORBITALPHA_RANGE_TRAIL_PULLBACK_MIN_PRICE_FRAC=0.0005
# ORBITALPHA_RANGE_TRAIL_ATR_MULT=0.35
# Optional: release defer if armed-but-not-locked this many ms (0 = off).
# ORBITALPHA_RANGE_TRAIL_MAX_ARMED_NO_LOCK_MS=0

# --- Paper loss streak (per regime): soft size trim first, shorter hard suspend (not full paperModeSuspendMs) ---
# Consecutive losses before soft-only size reduction (default 3). Must be < hard threshold.
# ORBITALPHA_PAPER_SOFT_LOSS_STREAK=3
# Consecutive losses before hard regime block (default 7). Env is clamped so it stays above soft.
# ORBITALPHA_PAPER_MODE_SUSPEND_LOSS_STREAK=7
# Hard suspend duration ms for loss-streak block (default 1200000 = 20m). Separate from ORBITALPHA_PAPER_MODE_SUSPEND_MS.
# ORBITALPHA_PAPER_HARD_SUSPEND_MS=1200000

# --- OKX signed REST auth (live/demo) ---
# Effective signed auth requires explicit opt-in:
#   ORBITALPHA_OKX_EXCHANGE_ENABLED=true
ORBITALPHA_OKX_EXCHANGE_ENABLED=false

# OKX live trading auth
OKX_LIVE_ENABLED=false
OKX_BASE_URL=https://www.okx.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# OKX demo auth
OKX_DEMO_ENABLED=false
OKX_DEMO_BASE_URL=https://www.okx.com
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_PASSPHRASE=

