{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": false,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": false,
        "types": [
            "node"
        ],
        "noEmit": true,
        "allowImportingTsExtensions": true
    },
    "include": [
        "index.ts",
        "../src/lib/futuresPaperBundleCore.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}