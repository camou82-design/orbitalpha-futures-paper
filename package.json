{
  "name": "orbitalpha-futures-paper",
  "version": "0.1.0",
  "private": true,
  "description": "Bybit USDT perpetual futures paper trading engine (simulation only). No live trading.",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:loop": "node dist/loop.js",
    "dev": "node --enable-source-maps --watch dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "report:decisions": "python scripts/report_decisions_jsonl.py --input data/reports/decisions.jsonl",
    "check:logs-none": "python scripts/check_logs_for_legacy_none.py data/reports/decisions.jsonl data/reports/events.jsonl",
    "check:funnel-monotonic": "python scripts/check_funnel_monotonic.py",
    "local:loop": "npm run start:loop",
    "local:web": "node dist/web/local-server.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}